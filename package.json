{
  "name": "uganuga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:phaser": "vite --config src-phaser/vite.config.ts",
    "build:phaser": "tsc --project src-phaser/tsconfig.json && vite build --config src-phaser/vite.config.ts",
    "preview:phaser": "vite preview --config src-phaser/vite.config.ts",
    "dev": "vite",
    "build": "vue-tsc -b && tsc --project src-phaser/tsconfig.json && vite build --outDir dist/old --emptyOutDir false && vite build --config src-phaser/vite.config.ts --outDir ../dist",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0"
  }
}
